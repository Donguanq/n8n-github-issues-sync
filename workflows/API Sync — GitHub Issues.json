      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        128,
        0
      ],
      "id": "f7f749c4-2078-481c-a96b-40e5ae06f449",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all().map(item => item.json);\n\nif (pages.length === 0) {\n  throw new Error('GitHub returned no pages');\n}\n\nif (pages.some(page => !Array.isArray(page.items))) {\n  throw new Error('Invalid GitHub response: items array is missing');\n}\n\nif (pages.some(page => page.incomplete_results === true)) {\n  throw new Error('GitHub marked the search results as incomplete');\n}\n\nconst expectedCount = Number(pages[0].total_count);\n\nif (!Number.isFinite(expectedCount)) {\n  throw new Error('GitHub total_count is missing or invalid');\n}\n\nif (pages.some(page => Number(page.total_count) !== expectedCount)) {\n  throw new Error('GitHub total_count changed between pages');\n}\n\nconst issues = pages.flatMap(page => page.items);\n\nif (issues.length !== expectedCount) {\n  throw new Error(\n    `Incomplete sync: expected ${expectedCount} results, received ${issues.length}`\n  );\n}\n\nconst normalizedIssues = issues\n  .filter(issue => !issue.pull_request)\n  .map(issue => ({\n    json: {\n      repository: 'n8n-io/n8n',\n      github_id: issue.id,\n      issue_number: issue.number,\n      title: issue.title,\n      state: issue.state,\n      author_login: issue.user?.login ?? null,\n      created_at: issue.created_at,\n      updated_at: issue.updated_at,\n      closed_at: issue.closed_at,\n      html_url: issue.html_url,\n      comments_count: issue.comments ?? 0,\n      locked: issue.locked ?? false,\n      labels: (issue.labels ?? []).map(label => label.name),\n      body: issue.body ?? null\n    }\n  }));\n\nif (normalizedIssues.length !== expectedCount) {\n  throw new Error('Unexpected pull requests found in issue results');\n}\n\nreturn [\n  {\n    json: {\n      issue_count: normalizedIssues.length,\n      issues: normalizedIssues.map(item => item.json),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        0
      ],
      "id": "6414aaf4-e1a4-4bde-83d4-ceb66afc38f4",
      "name": "Normalize Issues"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO github_issues_sync (\n    repository,\n    github_id,\n    issue_number,\n    title,\n    state,\n    author_login,\n    created_at,\n    updated_at,\n    closed_at,\n    html_url,\n    comments_count,\n    locked,\n    labels,\n    body,\n    sync_run_id,\n    last_synced_at\n)\nVALUES (\n    $1, $2, $3, $4, $5, $6,\n    $7::timestamptz,\n    $8::timestamptz,\n    $9::timestamptz,\n    $10, $11, $12, $13::jsonb, $14, $15, NOW()\n)\nON CONFLICT (repository, github_id)\nDO UPDATE SET\n    issue_number = EXCLUDED.issue_number,\n    title = EXCLUDED.title,\n    state = EXCLUDED.state,\n    author_login = EXCLUDED.author_login,\n    created_at = EXCLUDED.created_at,\n    updated_at = EXCLUDED.updated_at,\n    closed_at = EXCLUDED.closed_at,\n    html_url = EXCLUDED.html_url,\n    comments_count = EXCLUDED.comments_count,\n    locked = EXCLUDED.locked,\n    labels = EXCLUDED.labels,\n    body = EXCLUDED.body,\n    sync_run_id = EXCLUDED.sync_run_id,\n    last_synced_at = NOW()\nRETURNING\n    repository,\n    github_id,\n    issue_number,\n    state,\n    updated_at,\n    last_synced_at,\n    sync_run_id;",
        "options": {
          "queryBatching": "transaction",
          "queryReplacement": "={{ [\n  $json.repository,\n  $json.github_id,\n  $json.issue_number,\n  $json.title,\n  $json.state,\n  $json.author_login,\n  $json.created_at,\n  $json.updated_at,\n  $json.closed_at,\n  $json.html_url,\n  $json.comments_count,\n  $json.locked,\n  JSON.stringify($json.labels),\n  $json.body,\n  String($execution.id)\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1024,

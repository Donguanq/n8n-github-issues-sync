        "query": "SELECT\n    repository,\n    github_id,\n    issue_number,\n    state,\n    sync_run_id\nFROM github_issues_sync\nWHERE repository = 'n8n-io/n8n'\n  AND state = 'open'\n  AND sync_run_id IS DISTINCT FROM $1;",
